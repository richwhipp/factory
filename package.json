{
  "name": "factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "packageManager": "pnpm@9.15.9",
  "bin": {
    "factory": "dist/factory.mjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node build.mjs && vitest run",
    "verify": "tsc --noEmit && biome check . && node build.mjs && vitest run"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
